/* Security — "what you risk" / "what to do" for flagged checks */
"sec.filevault.risk" = "Your account password guards the login screen, not the disk itself. If the Mac is lost or opened up, the drive can be read from another computer: mail, documents and saved passwords, all of it.";
"sec.filevault.todo" = "System Settings → Privacy & Security → FileVault. Encryption runs in the background, so you can keep working. Store the recovery key somewhere other than the Mac.";
"sec.firewall.risk" = "On a shared network — a café, a coworking space, a hotel — anyone on the same Wi-Fi can knock on your Mac's open ports: local development servers, screen sharing, AirPlay. They have no password, but they can see which services are up and work through known vulnerabilities.";
"sec.firewall.todo" = "System Settings → Network → Firewall. It leaves outgoing connections alone — day to day you will not notice the difference.";
"sec.gatekeeper.risk" = "macOS stops checking signatures and notarization: a downloaded app launches silently, with no question about where it came from. A tampered installer looks exactly like the real one.";
"sec.gatekeeper.todo" = "Restore the check with sudo spctl --master-enable in Terminal, and allow the apps you need one at a time through “Open” in their context menu.";
"sec.sip.risk" = "System Integrity Protection keeps system files off limits even to root. While it is off, a process that gains root can settle into the system so deeply that reinstalling apps will not remove it.";
"sec.sip.todo" = "Restart into Recovery, open Terminal, run csrutil enable, then boot normally.";
"sec.autologin.risk" = "The Mac lands straight in your account at power-on — no password asked. Pressing the power button is enough to reach your mail, your keychain and your files.";
"sec.autologin.todo" = "System Settings → Users & Groups → “Automatic login” → “Off”.";
"sec.guest.risk" = "A guest session opens with no password, and file and printer sharing is visible from inside it. For a stranger it is a ready-made way into the network your Mac sits on.";
"sec.guest.todo" = "System Settings → Users & Groups → “Guest User”: turn off login and access to shared folders.";
"sec.updates.risk" = "Security updates close holes that are already public: one specially crafted page or file is enough to run someone else's code. With automatic checks off, you are the last to hear that a fix exists.";
"sec.updates.todo" = "System Settings → General → Software Update: turn automatic checks back on. Installing usually takes about ten minutes and one restart.";
"sec.screenlock.risk" = "The display sleeps but the session stays open: a touch of the trackpad is enough to reach your mail, your messengers and your keychain. In an office or a café that is the price of a minute away from the desk.";
"sec.screenlock.todo" = "System Settings → Lock Screen: “Require password after screen saver begins or display is turned off” → “Immediately”.";

