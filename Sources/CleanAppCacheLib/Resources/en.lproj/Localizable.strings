/* MARK: - First-run safety rules */
"onboard.access.body" = "Without Full Disk Access macOS hides part of the caches, and the app can neither measure nor clean them. Other permissions are asked for only when a feature needs them: Automation to read login items and to move protected files through Finder, and an administrator password for system files and apps.";
"onboard.access.granted" = "Full Disk Access granted";
"onboard.access.later" = "You can grant it later in Settings — the app works without it, it just sees less.";
"onboard.headline" = "What this app will and will not delete";
"onboard.lede" = "Three rules it follows on every screen. Read them once — nothing here works against them.";
"onboard.rule1.body" = "Files go to the Trash, not straight off the disk, so you can put them back. Only a few actions are permanent and have no undo: uninstalling apps, developer caches and build artifacts, browser privacy data, emptying the Trash and deleting Time Machine snapshots. Where macOS protects a file, the app says so and asks for your password first.";
"onboard.rule1.title" = "Everything is reversible by default";
"onboard.rule2.body" = "Only what is safe to remove is ticked for you. Anything that needs a decision — another user's data, system folders, media libraries — is refused outright, whatever the screen asked for.";
"onboard.rule2.title" = "Risky items are never preselected";
"onboard.rule3.body" = "Uninstalling finds leftovers by the app's identifier, never by a similar name. A folder called “Chrome something” is not removed because you uninstalled Chrome.";
